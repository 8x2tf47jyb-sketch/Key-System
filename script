	refreshMorseBtn.Font = Enum.Font.SourceSansBold
	refreshMorseBtn.TextSize = 12
	refreshMorseBtn.TextXAlignment = Enum.TextXAlignment.Left
	refreshMorseBtn.LayoutOrder = 100
	Instance.new("UICorner", refreshMorseBtn).CornerRadius = UDim.new(0, 4)

	local function refreshMorseNotes()
		for i = 1, 3 do
			local rawText, storeName = findNoteText("Note" .. i)
			local box = noteBoxes[i]
			if rawText and rawText ~= "" then
				box.title.Text      = "Note" .. i .. "  [" .. (storeName or "?") .. "]"
				box.translated.Text = morseToEnglish(rawText)
				box.raw.Text        = rawText
			else
				box.title.Text      = "Note" .. i
				box.translated.Text = "(not found)"
				box.raw.Text        = ""
			end
		end
	end

	refreshMorseBtn.MouseButton1Click:Connect(function()
		pcall(refreshMorseNotes)
		notify("Notes", "Refreshed", 2)
	end)

	task.spawn(function()
		task.wait(1.5); pcall(refreshMorseNotes)
		task.wait(3);   pcall(refreshMorseNotes)
	end)

