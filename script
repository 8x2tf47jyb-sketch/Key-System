--HARD DRAGGER
local hardDraggerActive = false
local hardDraggerConnection, hardDraggerConnection2, hardDraggerLoop
local hardDraggerStrength = 95000
local canDragHooked = false
local modifiedDraggers = {}
local draggerRefreshTick = 0

local function applyDraggerBoost(dragger)
	if not dragger or not dragger:IsA("BasePart") then return end
	local bp = dragger:FindFirstChild("BodyPosition")
	if not bp then
		bp = Instance.new("BodyPosition")
		bp.Name = "BodyPosition"
		pcall(function() bp.Parent = dragger end)
	end
	pcall(function()
		bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bp.P = hardDraggerStrength
		bp.D = 1000
	end)
	local bg = dragger:FindFirstChild("BodyGyro")
	if not bg then
		bg = Instance.new("BodyGyro")
		bg.Name = "BodyGyro"
		pcall(function() bg.Parent = dragger end)
	end
	pcall(function()
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = hardDraggerStrength
		bg.D = 1000
	end)
	dragger.Color = Color3.fromRGB(255, 20, 147)
	dragger.CanCollide = false
	dragger.Transparency = 0.4
	pcall(function() dragger:SetNetworkOwner(player) end)
	modifiedDraggers[dragger] = true
end

local function findDragger()
	local c = {}
	local w = Workspace:FindFirstChild("Dragger")
	if w and w:IsA("BasePart") then table.insert(c, w) end
	local gui = player:FindFirstChild("PlayerGui")
	if gui then
		local g = gui:FindFirstChild("ItemDraggingGUI")
		if g then
			local d = g:FindFirstChild("Dragger")
			if d and d:IsA("BasePart") then table.insert(c, d) end
		end
	end
	if #c == 0 then
		for _, v in ipairs(getnilinstances()) do
			if v.Name == "Dragger" and v:IsA("BasePart") then table.insert(c, v) end
		end
	end
	return c
end

local function startHardDragger(silent)
	if hardDraggerActive then return end
	hardDraggerActive = true
	if not canDragHooked then
		pcall(function()
			local ds = player.PlayerGui:FindFirstChild("ItemDraggingGUI") and player.PlayerGui.ItemDraggingGUI:FindFirstChild("Dragger")
			if ds then
				local env = getsenv(ds)
				if env and env.canDrag then
					hookfunction(env.canDrag, function() return true end)
					canDragHooked = true
				end
			end
		end)
	end
	for _, d in ipairs(findDragger()) do applyDraggerBoost(d) end

	hardDraggerConnection = Workspace.ChildAdded:Connect(function(child)
		if hardDraggerActive and child.Name == "Dragger" and child:IsA("BasePart") then
			task.wait(0.05); applyDraggerBoost(child)
		end
	end)
	local gui = player:FindFirstChild("PlayerGui")
	if gui then
		hardDraggerConnection2 = gui.ChildAdded:Connect(function(child)
			if hardDraggerActive and child.Name == "ItemDraggingGUI" then
				child.ChildAdded:Connect(function(gc)
					if hardDraggerActive and gc.Name == "Dragger" and gc:IsA("BasePart") then
						task.wait(0.05); applyDraggerBoost(gc)
					end
				end)
			end
		end)
	end

	hardDraggerLoop = RunService.Heartbeat:Connect(function()
		if not hardDraggerActive then return end
		draggerRefreshTick = draggerRefreshTick + 1
		if draggerRefreshTick < 3 then return end
		draggerRefreshTick = 0
		for d in pairs(modifiedDraggers) do
			if d and d.Parent then
				local bp = d:FindFirstChild("BodyPosition")
				if bp then bp.P = hardDraggerStrength end
				local bg = d:FindFirstChild("BodyGyro")
				if bg then bg.P = hardDraggerStrength end
			else
				modifiedDraggers[d] = nil
			end
		end
	end)

	if not silent then notify("Hard Dragger", "SUPER DRAG ON", 3) end
end

local function stopHardDragger(silent)
	hardDraggerActive = false
	if hardDraggerConnection then hardDraggerConnection:Disconnect(); hardDraggerConnection = nil end
	if hardDraggerConnection2 then hardDraggerConnection2:Disconnect(); hardDraggerConnection2 = nil end
	if hardDraggerLoop then hardDraggerLoop:Disconnect(); hardDraggerLoop = nil end
	for d in pairs(modifiedDraggers) do
		if d and d.Parent then
			local bp = d:FindFirstChild("BodyPosition"); if bp then bp:Destroy() end
			local bg = d:FindFirstChild("BodyGyro"); if bg then bg:Destroy() end
			d.Color = Color3.new(1,1,1)
			d.CanCollide = true
			d.Transparency = 0
		end
	end
	modifiedDraggers = {}
	if not silent then notify("Hard Dragger", "OFF", 2) end
end

--ITEM TELEPORTER
local selectedItems = {}
local selectionMode = false
local itemTPBusy    = false

local function getItemModel(part)
	if not part then return nil end
	local model = part:FindFirstAncestorOfClass("Model")
	if model then
		if Players:GetPlayerFromCharacter(model) then return nil end
		return model
	end
	if part:IsA("BasePart") then return part end
	return nil
end

local function getTeleportTarget(item)
	if not item then return nil, nil end
	if item:IsA("BasePart") then return item, item end
	local ws = item:FindFirstChild("WoodSection")
	if ws and ws:IsA("BasePart") then return ws, item end
	local main = item:FindFirstChild("Main")
	if main and main:IsA("BasePart") then return main, item end
	for _, p in ipairs(item:GetDescendants()) do
		if p.Name == "WoodSection" and p:IsA("BasePart") then return p, item end
	end
	local any = item:FindFirstChildWhichIsA("BasePart", true)
	if any and any.Name ~= "Leaves" and any.Name ~= "InnerWood" then return any, item end
	return nil, nil
end

local function isPlank(root)
	if not root then return false end
	if root:GetAttribute("Type") == "Plank" then return true end
	return root.Name:lower():find("plank") ~= nil or root:FindFirstChild("Plank") ~= nil
end

local function addHighlight(item)
	if item:FindFirstChild("Morty_Highlight") then return end
	local hl = Instance.new("Highlight")
	hl.Name = "Morty_Highlight"
	hl.FillColor = Color3.fromRGB(16, 52, 166)
	hl.OutlineColor = Color3.fromRGB(152, 251, 152)
	hl.FillTransparency = 0.01
	hl.OutlineTransparency = 0.01
	hl.Parent = item
end

local function removeHighlight(item)
	local hl = item:FindFirstChild("Morty_Highlight"); if hl then hl:Destroy() end
end

local function clearSelection()
	for _, item in ipairs(selectedItems) do removeHighlight(item) end
	selectedItems = {}
	notify("Item TP", "Selection cleared.", 2)
end

local function addToSelection(item, silent)
	if not item or not item.Parent then return false end
	for _, v in ipairs(selectedItems) do
		if v == item then return false end
	end
	table.insert(selectedItems, item)
	addHighlight(item)
	if not silent then
		notify("Item TP", "Added " .. item.Name .. " (" .. #selectedItems .. ")", 2)
	end
	return true
end

local function performTeleport(orientation)
	orientation = orientation or "normal"
	if itemTPBusy or #selectedItems == 0 then
		if #selectedItems == 0 then notify("Item TP", "Nothing selected!", 4) end
		return
	end

	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp or not dragRemote then
		notify("Item TP", "Teleport system is not ready!", 3)
		return
	end

	itemTPBusy = true
	local wasActive = hardDraggerActive
	if not wasActive then startHardDragger(true); task.wait(0.3) end

	local speedFactor = math.max(0.01, teleportSpeed / 100)
	local baseWait = math.max(0.015, 0.03 / speedFactor)
	local maxRetries = math.clamp(math.floor(4 / speedFactor) + 1, 2, 6)
	local oldCF = hrp.CFrame
	local lookFlat = Vector3.new(oldCF.LookVector.X, 0, oldCF.LookVector.Z)
	if lookFlat.Magnitude < 0.001 then lookFlat = Vector3.new(0, 0, -1) end
	lookFlat = lookFlat.Unit
	local rightFlat = Vector3.new(-lookFlat.Z, 0, lookFlat.X)
	local successCount = 0
	local total = #selectedItems
	local itemsToKeep = {}
	local placeIndex = 0

	for _, item in ipairs(selectedItems) do
		if not item or not item.Parent then continue end

		local main, root = getTeleportTarget(item)
		if not main or not root then
			table.insert(itemsToKeep, item)
			continue
		end

		placeIndex = placeIndex + 1
		local side = ((placeIndex - 1) % 5) - 2
		local targetPos = oldCF.Position + lookFlat * 4 + rightFlat * (side * 3) + Vector3.new(0, 1, 0)

		local targetCF = CFrame.new(targetPos, targetPos + lookFlat)
		if orientation == "sideways" then
			targetCF = CFrame.fromMatrix(targetPos, rightFlat, Vector3.new(0, 1, 0), -lookFlat) * CFrame.Angles(0, 0, math.rad(90))
		elseif orientation == "upwards" then
			targetCF = CFrame.new(targetPos, targetPos + lookFlat) * CFrame.Angles(math.rad(-90), 0, 0)
		elseif isPlank(root) then
			targetCF = CFrame.new(targetPos, targetPos + lookFlat) * CFrame.Angles(math.rad(90), 0, 0)
		end

		local thisDragId = nextDragId()
		local originalPos = main.Position
		local moved = false

		for attempt = 1, maxRetries do
			if root:IsA("Model") then pcall(function() root.PrimaryPart = main end) end
			pcall(function() main:SetNetworkOwner(player) end)
			local wasAnchored = main.Anchored
			main.Anchored = false

			hrp.CFrame = main.CFrame
			task.wait(baseWait)
			pcall(function() dragRemote:FireServer("Begin", root, thisDragId) end)
			task.wait(baseWait)
			pcall(function() dragRemote:FireServer("Refresh", root, thisDragId) end)
			task.wait(baseWait)

			main.AssemblyLinearVelocity = Vector3.zero
			main.AssemblyAngularVelocity = Vector3.zero

			local draggerParts = findDragger()
			for _ = 1, 8 do
				if root:IsA("Model") then pcall(function() root.PrimaryPart = main; root:PivotTo(targetCF) end) end
				main.CFrame = targetCF
				for _, d in ipairs(draggerParts) do
					if d and d.Parent then d.CFrame = targetCF end
				end
				pcall(function() dragRemote:FireServer("Refresh", root, thisDragId) end)
				task.wait(baseWait)
			end

			for _ = 1, 4 do
				pcall(function() dragRemote:FireServer("Refresh", root, thisDragId) end)
				task.wait(baseWait)
			end

			for _ = 1, 3 do
				pcall(function() dragRemote:FireServer("End", root, thisDragId) end)
				if forceEndDragRemote then pcall(function() forceEndDragRemote:FireServer() end) end
				task.wait(0.05)
			end

			for _, d in ipairs(findDragger()) do
				if d and d.Parent then pcall(function() d:Destroy() end) end
			end

			task.wait(0.15)
			main.Anchored = wasAnchored
			main.AssemblyLinearVelocity = Vector3.zero
			main.AssemblyAngularVelocity = Vector3.zero
			pcall(function() main:SetNetworkOwner(nil) end)

			if (main.Position - targetPos).Magnitude < 8 then
				moved = true
				break
			end
			task.wait(baseWait)
		end

		if moved then
			successCount += 1
			removeHighlight(item)
		else
			table.insert(itemsToKeep, item)
		end
	end

	selectedItems = itemsToKeep
	hrp.CFrame = oldCF
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)
	notify("Item TP", ("Teleported %d/%d items!"):format(successCount, total), 4)

	if not wasActive then stopHardDragger(true) end
	itemTPBusy = false
end

local function selectLookingAt()
	if not selectionMode then return end
	local target = mouse.Target
	if not target then notify("Item TP", "Look at an item to select!", 2); return end
	local model = getItemModel(target)
	if not model then notify("Item TP", "Not a valid item!", 3); return end
	for i, v in ipairs(selectedItems) do
		if v == model then
			removeHighlight(model)
			table.remove(selectedItems, i)
			notify("Deselected", model.Name .. " (" .. #selectedItems .. ")", 2)
			return
		end
	end
	table.insert(selectedItems, model)
	addHighlight(model)
	notify("Selected", model.Name .. " (" .. #selectedItems .. ")", 2)
end

