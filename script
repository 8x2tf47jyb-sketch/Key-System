local function placeItemAtBottom(item, dropPos)
	if not item or not item.Parent then return end
	if item:IsA("Model") then
		local bboxCF, bboxSize = item:GetBoundingBox()
		local targetCenter = Vector3.new(
			dropPos.X,
			dropPos.Y + bboxSize.Y / 2 + PLACE_LIFT,
			dropPos.Z
		)
		local delta = targetCenter - bboxCF.Position
		pcall(function() item:TranslateBy(delta) end)
	else
		local targetPos = Vector3.new(
			dropPos.X,
			dropPos.Y + item.Size.Y / 2 + PLACE_LIFT,
			dropPos.Z
		)
		item.CFrame = CFrame.new(targetPos)
	end
end

-- Drag-based move (same pipeline as Item TP) so server syncs and item stays movable
local function dragMoveItemTo(item, targetPos)
	if not item or not item.Parent or not dragRemote then return false end
	local main, rootModel = getTeleportTarget(item)
	if not main or not rootModel then return false end

	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then return false end

	local targetCF = CFrame.new(targetPos)
	if isPlank(rootModel) then
		targetCF = targetCF * CFrame.Angles(math.rad(90), 0, 0)
	end

	local thisDragId = nextDragId()
	local originalCF = hrp.CFrame
	local wasAnchored = main.Anchored

	if rootModel:IsA("Model") then pcall(function() rootModel.PrimaryPart = main end) end
	pcall(function() main:SetNetworkOwner(player) end)
	main.Anchored = false

	hrp.CFrame = main.CFrame
	task.wait(0.04)
	pcall(function() dragRemote:FireServer("Begin", rootModel, thisDragId) end)
	task.wait(0.04)
	pcall(function() dragRemote:FireServer("Refresh", rootModel, thisDragId) end)
	task.wait(0.04)

	main.AssemblyLinearVelocity = Vector3.zero
	main.AssemblyAngularVelocity = Vector3.zero

	local draggerParts = findDragger()
	for _ = 1, 10 do
		if rootModel:IsA("Model") then
			pcall(function() rootModel.PrimaryPart = main; rootModel:PivotTo(targetCF) end)
		end
		main.CFrame = targetCF
		for _, d in ipairs(draggerParts) do
			if d and d.Parent then d.CFrame = targetCF end
		end
		pcall(function() dragRemote:FireServer("Refresh", rootModel, thisDragId) end)
		task.wait(0.03)
	end

	for _ = 1, 4 do
		pcall(function() dragRemote:FireServer("Refresh", rootModel, thisDragId) end)
		task.wait(0.03)
	end

	for _ = 1, 3 do
		pcall(function() dragRemote:FireServer("End", rootModel, thisDragId) end)
		if forceEndDragRemote then pcall(function() forceEndDragRemote:FireServer() end) end
		task.wait(0.05)
	end

	for _, d in ipairs(findDragger()) do
		if d and d.Parent then pcall(function() d:Destroy() end) end
	end

	task.wait(0.1)
	main.Anchored = wasAnchored
	main.AssemblyLinearVelocity = Vector3.zero
	main.AssemblyAngularVelocity = Vector3.zero
	pcall(function() main:SetNetworkOwner(nil) end)

	hrp.CFrame = originalCF
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end)

	return (main.Position - targetPos).Magnitude < 15
end

local function discoverStores()
	local list = {}
	local root = Workspace:FindFirstChild("Stores")
	if not root then return list end

	for _, folder in ipairs(root:GetChildren()) do
		if SKIP_STORES[folder.Name] then continue end
		local shop = folder:FindFirstChild("ShopItems")
		if not shop then continue end

		local npc
		for _, child in ipairs(folder:GetChildren()) do
			if child:FindFirstChild("Dialog") then npc = child; break end
		end
		if not npc then continue end

		local override = STORE_OVERRIDES[folder.Name]
		list[#list + 1] = {
			storeName = folder.Name,
			folder    = folder,
			npc       = npc,
			shop      = shop,
			region    = "Store_" .. folder.Name,
			dropPos   = override and override.dropPos,
			podiums   = (override and override.podiums) or PLATFORM_POSITIONS,
		}
	end
	return list
end

local function findShopItemByCDOrName(entry, target)
	if not entry or not entry.shop or not target then return nil end
	for _, c in ipairs(entry.shop:GetChildren()) do
		if c:IsA("Model") and getCDValue(c) == target then
			return c
		end
	end
	for _, c in ipairs(entry.shop:GetChildren()) do
		if c:IsA("Model") and c.Name == target then
			return c
		end
	end
	return nil
end

local function findCurrentShopItem(entry, target)
	return findShopItemByCDOrName(entry, target)
end

local function waitForShopItem(entry, target, previous, timeout)
	timeout = timeout or SHOP_REROLL_TIMEOUT
	local t0 = os.clock()
	task.wait(SHOP_SETTLE_TIME)
	while os.clock() - t0 < timeout do
		local current = findShopItemByCDOrName(entry, target)
		if current and current ~= previous then
			return current
		end
		task.wait(SHOP_POLL_INTERVAL)
	end
	return nil
end

