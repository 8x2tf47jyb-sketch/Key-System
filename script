	local function buyItemMultiple(entry, itemKey, times)
		times = math.max(1, math.floor(tonumber(times) or 1))
		local bought = 0
		local lastBought = nil

		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local startCF = root and root.CFrame

		for i = 1, times do
			local current = findShopItemByCDOrName(entry, itemKey)
			if not current then
				current = waitForShopItem(entry, itemKey, lastBought, SHOP_REROLL_TIMEOUT)
			end
			if not current then
				if bought == 0 then
					notify("AutoBuy", itemKey .. " not in shop", 2)
				else
					notify("AutoBuy", ("Bought %d/%d of %s (timeout)"):format(bought, times, itemKey), 3)
				end
				returnHome(root, startCF)
				return
			end

			lastBought = current
			pcall(buyItem, entry, current, true)
			bought = bought + 1

			if i < times then
				local fresh = waitForShopItem(entry, itemKey, lastBought, SHOP_REROLL_TIMEOUT)
				if not fresh then
					notify("AutoBuy", ("Bought %d/%d of %s (respawn timeout)"):format(bought, times, itemKey), 3)
					returnHome(root, startCF)
					return
				end
				lastBought = fresh
			end
		end

		returnHome(root, startCF)
		notify("AutoBuy", ("Bought %d x %s"):format(bought, itemKey), 2)
	end

