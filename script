--FOLLOW PLAYER TROLL
local followTarget = nil
local followConnection = nil
local followSpin = 0

local function stopFollow()
	followTarget = nil
	if followConnection then followConnection:Disconnect(); followConnection = nil end
	notify("Follow Troll", "Stopped following", 2)
end

local function startFollow(targetPlayer)
	if not targetPlayer then return end
	followTarget = targetPlayer
	if followConnection then followConnection:Disconnect() end
	followConnection = RunService.Heartbeat:Connect(function(dt)
		if not followTarget or not followTarget.Parent then
			stopFollow()
			return
		end
		local myChar = player.Character
		local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local tgtChar = followTarget.Character
		local tgtHrp = tgtChar and tgtChar:FindFirstChild("HumanoidRootPart")
		if myHrp and tgtHrp then
			followSpin = followSpin + dt * 4
			local tgtCF = tgtHrp.CFrame
			local back = tgtCF.LookVector * -3
			local side = tgtCF.RightVector * math.sin(followSpin) * 1.5
			local pos = tgtCF.Position + back + side
			myHrp.CFrame = CFrame.new(pos, tgtCF.Position)
			myHrp.AssemblyLinearVelocity = Vector3.zero
			myHrp.AssemblyAngularVelocity = Vector3.zero
		end
	end)
	notify("Follow Troll", "Now following " .. targetPlayer.Name, 3)
end

--FLIGHT
local function ToggleFly()
	flying = not flying
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChild("Humanoid")
	if not hrp or not hum then return end

	if flying then
		local BV = Instance.new("BodyVelocity")
		BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		BV.Name = "MortyFly"
		BV.Velocity = Vector3.zero
		BV.Parent = hrp
		local BG = Instance.new("BodyGyro")
		BG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		BG.Name = "MortyGyro"
		BG.CFrame = hrp.CFrame
		BG.Parent = hrp
		task.spawn(function()
			while flying and player.Character and hrp:FindFirstChild("MortyFly") do
				local dir = Vector3.zero
				if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + camera.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - camera.CFrame.LookVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - camera.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + camera.CFrame.RightVector end
				if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, 1, 0) end
				if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0, 1, 0) end
				if dir.Magnitude > 0 then dir = dir.Unit end
				BV.Velocity = dir * fSpeed
				BG.CFrame = camera.CFrame
				RunService.RenderStepped:Wait()
			end
			if BV and BV.Parent then BV:Destroy() end
			if BG and BG.Parent then BG:Destroy() end
		end)
		notify("Fly", "ON (WASD + Space/Ctrl)", 3)
	else
		if hrp:FindFirstChild("MortyFly") then hrp.MortyFly:Destroy() end
		if hrp:FindFirstChild("MortyGyro") then hrp.MortyGyro:Destroy() end
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		notify("Fly", "OFF", 2)
	end
end

--BTOOLS 
local deletedHistory = {}
local deleteToolInstance = nil
local undoToolInstance  = nil

local function undoDelete()
	if #deletedHistory > 0 then
		local lastRecord = table.remove(deletedHistory)
		if lastRecord and lastRecord.item then
			lastRecord.item.Parent = lastRecord.parent
			if lastRecord.item:IsA("BasePart") and lastRecord.cframe then
				lastRecord.item.CFrame = lastRecord.cframe
			end
			notify("Btools", "Restored last deleted item!", 2)
		end
	else
		notify("Btools", "Nothing to undo!", 2)
	end
end

local function setBtoolsState(state)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character

	if not state then
		if deleteToolInstance then deleteToolInstance:Destroy(); deleteToolInstance = nil end
		if undoToolInstance then undoToolInstance:Destroy(); undoToolInstance = nil end
		if backpack then
			for _, t in ipairs(backpack:GetChildren()) do
				if t.Name == "delete" or t.Name == "undo" then t:Destroy() end
			end
		end
		if char then
			for _, t in ipairs(char:GetChildren()) do
				if t.Name == "delete" or t.Name == "undo" then t:Destroy() end
			end
		end
		notify("Btools", "Btools Disabled", 2)
	else
		if not backpack then return end
		if deleteToolInstance then deleteToolInstance:Destroy() end
		if undoToolInstance then undoToolInstance:Destroy() end

		local hammer = Instance.new("Tool")
		hammer.Name = "delete"
		hammer.RequiresHandle = false
		hammer.Activated:Connect(function()
			local target = mouse.Target
			if target then
				local record = {
					parent = target.Parent,
					cframe = target:IsA("BasePart") and target.CFrame or nil,
					item   = target:Clone()
				}
				table.insert(deletedHistory, record)
				target:Destroy()
				notify("Btools", "Delete Successful", 2)
			end
		end)
		hammer.Parent = backpack
		deleteToolInstance = hammer

		local undoTool = Instance.new("Tool")
		undoTool.Name = "undo"
		undoTool.RequiresHandle = false
		undoTool.Activated:Connect(function() undoDelete() end)
		undoTool.Parent = backpack
		undoToolInstance = undoTool

		notify("Btools", "Btools & Undo Enabled", 3)
	end
end

