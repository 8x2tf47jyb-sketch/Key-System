						pcall(function() dragRemote:FireServer("Begin", Plank, thisDragId) end)
						for i=1,8 do
							task.wait(0.03)
							pcall(function() dragRemote:FireServer("Refresh", Plank, thisDragId) end)
						end
						pcall(function() dragRemote:FireServer("End", Plank, thisDragId) end)
						if forceEndDragRemote then pcall(function() forceEndDragRemote:FireServer() end) end
						safeSetNetworkOwner(v, nil)
					end)
				end
			end
		end
	end

	task.wait(1)
	equipToolByName(toolName)
end

