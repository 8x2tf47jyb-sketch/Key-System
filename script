		title.Font = Enum.Font.SourceSansBold
		title.TextSize = 16
		title.TextXAlignment = Enum.TextXAlignment.Left
		title.Parent = card

		local date = Instance.new("TextLabel")
		date.Size = UDim2.new(1, 0, 0, 18)
