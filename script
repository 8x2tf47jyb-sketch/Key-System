local function normalizePhrase(s)
    if not s then return "" end
    s = s:lower():gsub("[%p]", " "):gsub("%s+", " ")
    return s:gsub("^%s+", ""):gsub("%s+$", "")
end

local NOTE_PHRASE_LOOKUP = {}
for phrase, item in pairs(NOTE_PHRASE_TO_ITEM) do
    NOTE_PHRASE_LOOKUP[normalizePhrase(phrase)] = { item = item, phrase = phrase }
end

local function getItemFromDecodedNote(decoded)
    if not decoded or decoded == "" then return nil, nil end
    local norm = normalizePhrase(decoded)
    if norm == "" then return nil, nil end
    if NOTE_PHRASE_LOOKUP[norm] then
        return NOTE_PHRASE_LOOKUP[norm].item, NOTE_PHRASE_LOOKUP[norm].phrase
    end
    for key, entry in pairs(NOTE_PHRASE_LOOKUP) do
        if norm:find(key, 1, true) then return entry.item, entry.phrase end
    end
    for _, rule in ipairs(NOTE_KEYWORD_RULES) do
        for _, kw in ipairs(rule.words) do
            if norm:find(kw, 1, true) then return rule.item, norm end
        end
    end
    return nil, nil
end

local function findStoreEntryByKeywords(storeList, keywords)
    if not storeList or not keywords then return nil end
    for _, entry in ipairs(storeList) do
        local n = entry.storeName:lower():gsub("%s+", "")
        for _, kw in ipairs(keywords) do
            local k = kw:lower():gsub("%s+", "")
            if n:find(k, 1, true) then return entry end
        end
    end
    return nil
end

local function snapshotItemSet(items)
    local s = {}
    for _, it in ipairs(items) do s[it] = true end
    return s
end

local function findItemsInWorld(itemName)
    local found = {}
    if not itemName or itemName == "" then return found end
    local target = itemName:lower()
    local seen = {}
    local function checkObj(obj)
        if not obj or seen[obj] then return end
        local n = obj.Name:lower()
        local isExact = (n == target)
        local isPartial = (not isExact) and n:find(target, 1, true)
        if isExact or isPartial then
            if obj:IsA("Model") and (obj:FindFirstChild("Main") or obj.PrimaryPart) then
                if not Players:GetPlayerFromCharacter(obj) then
                    seen[obj] = true; table.insert(found, obj)
                end
            elseif obj:IsA("BasePart") and not Players:GetPlayerFromCharacter(obj.Parent) then
                seen[obj] = true; table.insert(found, obj)
            end
        end
    end
    for _, c in ipairs(Workspace:GetChildren()) do
        checkObj(c)
        if c:IsA("Folder") or c:IsA("Model") then
            for _, sub in ipairs(c:GetChildren()) do
                checkObj(sub)
                if sub:IsA("Folder") or sub:IsA("Model") then
                    for _, subsub in ipairs(sub:GetChildren()) do checkObj(subsub) end
                end
            end
        end
    end
    return found
end

local function teleportItemToPos(item, targetPos)
    if not item or not item.Parent then return false end
    local main, root = getTeleportTarget(item)
    if not main or not root then return false end

    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not dragRemote then return false end

    local originalCF = hrp.CFrame
    if root:IsA("Model") then pcall(function() root.PrimaryPart = main end) end
    pcall(function() main:SetNetworkOwner(player) end)
    local wasAnchored = main.Anchored
    main.Anchored = false

    local thisDragId = nextDragId()
    hrp.CFrame = main.CFrame
    task.wait(0.05)
    pcall(function() dragRemote:FireServer("Begin", root, thisDragId) end)
    task.wait(0.05)
    pcall(function() dragRemote:FireServer("Refresh", root, thisDragId) end)
    task.wait(0.05)

    local targetCF = CFrame.new(targetPos)
    main.AssemblyLinearVelocity = Vector3.zero
    main.AssemblyAngularVelocity = Vector3.zero

    local draggerParts = findDragger()
    for _ = 1, 10 do
        if noteAutoTPAbort then break end
        if root:IsA("Model") then
            pcall(function() root.PrimaryPart = main; root:PivotTo(targetCF) end)
        end
        main.CFrame = targetCF
        for _, d in ipairs(draggerParts) do
            if d and d.Parent then d.CFrame = targetCF end
        end
        pcall(function() dragRemote:FireServer("Refresh", root, thisDragId) end)
        task.wait(0.025)
    end

    for _ = 1, 4 do
        pcall(function() dragRemote:FireServer("Refresh", root, thisDragId) end)
        task.wait(0.03)
    end
    task.wait(0.1)

    for _ = 1, 3 do
        pcall(function() dragRemote:FireServer("End", root, thisDragId) end)
        if forceEndDragRemote then pcall(function() forceEndDragRemote:FireServer() end) end
        task.wait(0.05)
    end

    for _, d in ipairs(findDragger()) do
        if d and d.Parent then pcall(function() d:Destroy() end) end
    end

    task.wait(0.15)
    main.Anchored = wasAnchored
    main.AssemblyLinearVelocity = Vector3.zero
    main.AssemblyAngularVelocity = Vector3.zero
    pcall(function() main:SetNetworkOwner(nil) end)
    hrp.CFrame = originalCF
    return (main.Position - targetPos).Magnitude < 30
end

local function runNoteAutoTP(statusCb)
    if noteAutoTPRunning then return end
    noteAutoTPRunning = true
    noteAutoTPAbort = false

    local wasActive = hardDraggerActive
    if not wasActive then startHardDragger(true); task.wait(0.3) end

    local storeList = discoverStores()
    local totalSent = 0

    for i = 1, 3 do
        if noteAutoTPAbort then break end

        local platformIdx = notePlatformTargets[i] or i
        if platformIdx < 1 or platformIdx > 3 then platformIdx = 1 end
        local targetPos = PLATFORM_POSITIONS[platformIdx]

        local rawText = findNoteText("Note" .. i)
        local decoded = morseToEnglish(rawText or "")
        local itemName, phrase = getItemFromDecodedNote(decoded)

        if statusCb then statusCb(i, phrase or decoded, itemName, "reading") end

        if itemName then
            local storeKeywords = NOTE_ITEM_TO_STORE[itemName]
            local storeEntry    = storeKeywords and findStoreEntryByKeywords(storeList, storeKeywords) or nil

            local moved = 0
            for k = 1, noteQuantity do
                if noteAutoTPAbort then break end

                local boughtItem = nil

                if storeEntry then
                    if statusCb then
                        statusCb(i, phrase, itemName, ("buying %d/%d from %s"):format(k, noteQuantity, storeEntry.storeName))
                    end
                    local shopItem = findShopItemByCDOrName(storeEntry, itemName)
                    if not shopItem then
                        shopItem = waitForShopItem(storeEntry, itemName, nil, 3.0)
                    end
                    if shopItem then
                        local beforeSet = snapshotItemSet(findItemsInWorld(itemName))
                        pcall(buyItem, storeEntry, shopItem, true)
                        task.wait(0.5)
                        local after = findItemsInWorld(itemName)
                        for _, it in ipairs(after) do
                            if not beforeSet[it] then boughtItem = it; break end
                        end
                        if not boughtItem and #after > 0 then boughtItem = after[1] end
                    else
                        if statusCb then statusCb(i, phrase, itemName, "not in shop") end
                    end
                else
                    if statusCb then
                        statusCb(i, phrase, itemName, ("world search %d/%d"):format(k, noteQuantity))
                    end
                    local items = findItemsInWorld(itemName)
                    if #items >= k then boughtItem = items[k] end
                end

                if boughtItem then
                    if statusCb then
                        statusCb(i, phrase, itemName, ("teleporting %d/%d -> platform %d"):format(k, noteQuantity, platformIdx))
                    end
                    local ok = teleportItemToPos(boughtItem, targetPos)
                    if ok then moved = moved + 1; totalSent = totalSent + 1 end
                else
                    if statusCb then statusCb(i, phrase, itemName, "no instance found") end
                    break
                end

                task.wait(0.3)
            end

            if statusCb then
                statusCb(i, phrase, itemName, ("done %d/%d -> platform %d"):format(moved, noteQuantity, platformIdx))
            end
        else
            if statusCb then statusCb(i, decoded, nil, "unknown") end
        end

        task.wait(0.2)
    end

    if not wasActive then stopHardDragger(true) end
    noteAutoTPRunning = false
    if statusCb then
        statusCb(0, noteAutoTPAbort and "Aborted" or ("Done — %d items moved"):format(totalSent), nil, "final")
    end
end

