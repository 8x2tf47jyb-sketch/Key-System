local function buyItem(entry, item, skipReturn)
	if not entry or not item then return end

	local char = player.Character
	if not char then return end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local startCF = root.CFrame

	if not item.Parent or item.Parent ~= entry.shop then
		local current = findCurrentShopItem(entry, item.Name)
		if not current then
			notify("AutoBuy", item.Name .. " no longer in shop", 2)
			return
		end
		item = current
	end

	local itemPart = item:FindFirstChild("Main") or item.PrimaryPart
	if not itemPart then warn(("[buy] %s has no Main"):format(item.Name)); return end

	local npcId   = LEARNED_IDS[entry.npc.Name] or 0
	local npcRoot = entry.npc:FindFirstChild("HumanoidRootPart") or entry.npc.PrimaryPart
	if not npcRoot then warn(("[buy] %s has no NPC root"):format(entry.storeName)); return end
	if not (dragRemote and ClientChangedRegion and PlayerChatted and SetChattingValue) then
		notify("AutoBuy", "Missing remotes!", 3); return
	end

	local teleportData = getStoreTeleportData(entry.storeName, item)
	local effectiveDropPos = teleportData.dropPos or entry.dropPos

	local wasDraggerActive = hardDraggerActive
	if not wasDraggerActive then
		startHardDragger(true)
		task.wait(0.25)
	end

	local counterPos = effectiveDropPos
	if not counterPos then
		counterPos = npcRoot.Position + Vector3.new(0, 0, -4)
	else
		counterPos = Vector3.new(counterPos.X, counterPos.Y + PLACE_LIFT, counterPos.Z)
	end

	root.CFrame = CFrame.new(itemPart.Position + Vector3.new(0, HEIGHT_OFFSET, 0))
	task.wait(BUY_DELAY)

	-- Item-TP style drag onto the counter (server-synced, stays movable)
	local movedOk = dragMoveItemTo(item, counterPos)
	if not movedOk then
		placeItemAtBottom(item, counterPos)
		local main = item:FindFirstChild("Main") or item.PrimaryPart
		if main then
			pcall(function() main.Anchored = false end)
			pcall(function() main:SetNetworkOwner(nil) end)
		end
	end
	task.wait(BUY_DELAY)

	root.CFrame = CFrame.new(npcRoot.Position + Vector3.new(0, HEIGHT_OFFSET, 0))
	task.wait(BUY_DELAY)

	pcall(function() ClientChangedRegion:FireServer(entry.region) end)
	task.wait(0.2)

	local npcTbl = {ID = npcId, Character = entry.npc, Name = entry.npc.Name, Dialog = entry.npc.Dialog}
	pcall(function() SetChattingValue:InvokeServer(1) end)
	task.wait(0.2)
	local ok, res = pcall(function() return PlayerChatted:InvokeServer(npcTbl, "Initiate") end)
	print(("[buy] %s/%s initiate %s %s"):format(entry.storeName, item.Name, tostring(ok), tostring(res)))

	pcall(function() SetChattingValue:InvokeServer(2) end)
	task.wait(0.2)
	ok, res = pcall(function() return PlayerChatted:InvokeServer(npcTbl, "ConfirmPurchase") end)
	print(("[buy] %s/%s confirm %s %s"):format(entry.storeName, item.Name, tostring(ok), tostring(res)))

	pcall(function() PlayerChatted:InvokeServer(npcTbl, "EndChat") end)
	pcall(function() SetChattingValue:InvokeServer(0) end)
	task.wait(0.6)

	if selectionMode then
		local added = addToSelection(item, true)
		if added then
			notify("Item TP", "Auto-selected " .. item.Name .. " (" .. #selectedItems .. ")", 2)
		end
	end

	if effectiveDropPos and item and item.Parent then
		local dir = effectiveDropPos - npcRoot.Position
		dir = Vector3.new(dir.X, 0, dir.Z)
		if dir.Magnitude > 0.001 then
			dir = dir.Unit
		else
			dir = Vector3.new(0, 0, -1)
		end
		local offPos = effectiveDropPos + dir * OFF_COUNTER_NUDGE + Vector3.new(0, PLACE_LIFT, 0)
		local nudged = dragMoveItemTo(item, offPos)
		if not nudged then
			pcall(function()
				if item:IsA("Model") then
					item:TranslateBy(dir * OFF_COUNTER_NUDGE)
				elseif item:IsA("BasePart") then
					item.CFrame = item.CFrame + dir * OFF_COUNTER_NUDGE
				end
			end)
		end
		local mainPart = item:FindFirstChild("Main") or item.PrimaryPart
		if mainPart then
			pcall(function() mainPart.Anchored = false end)
			pcall(function() mainPart:SetNetworkOwner(nil) end)
			pcall(function()
				mainPart.AssemblyLinearVelocity = Vector3.zero
				mainPart.AssemblyAngularVelocity = Vector3.zero
			end)
		end
		task.wait(0.05)
	end

	if not skipReturn then
		root.CFrame = startCF
		task.wait(0.05)
		pcall(function()
			root.AssemblyLinearVelocity = Vector3.zero
			root.AssemblyAngularVelocity = Vector3.zero
		end)
		print(("[buy] %s/%s confirmed; player returned home"):format(entry.storeName, item.Name))
	else
		print(("[buy] %s/%s confirmed; holding position"):format(entry.storeName, item.Name))
	end

	if not wasDraggerActive then
		stopHardDragger(true)
	end
end

