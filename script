	local function getSearchQuery()
		local q = searchBox.Text or ""
		q = q:lower():gsub("^%s+", ""):gsub("%s+$", "")
		return q
	end

	local function passesFilter(storeName, itemName)
		local q = getSearchQuery()
		if q == "" then return true end
		local lStore = storeName:lower()
		local lItem  = (itemName or ""):lower()
		return lStore:find(q, 1, true) ~= nil or lItem:find(q, 1, true) ~= nil
	end

	local function rebuildAutobuy()
		for _, c in ipairs(storeEntriesFrame:GetChildren()) do
			if not c:IsA("UIListLayout") then c:Destroy() end
		end

		local n = 0
		for _ in pairs(LEARNED_IDS) do n = n + 1 end
		learnedLabel.Text = ("Learned NPC IDs: %d"):format(n)

		cachedStoreData = discoverStores()
		if #cachedStoreData == 0 then
			local empty = Instance.new("TextLabel", storeEntriesFrame)
			empty.Size = UDim2.new(1, 0, 0, 0)
			empty.AutomaticSize = Enum.AutomaticSize.Y
			empty.BackgroundTransparency = 1
			empty.Text = "No stores found. Walk near stores or refresh."
			empty.TextColor3 = Color3.fromRGB(180, 180, 180)
			empty.Font = Enum.Font.SourceSans
			empty.TextSize = 12
			empty.TextWrapped = true
			empty.TextXAlignment = Enum.TextXAlignment.Left
			empty.TextYAlignment = Enum.TextYAlignment.Top
			return
		end

		local order = 0
		for i, entry in ipairs(cachedStoreData) do
			local id = LEARNED_IDS[entry.npc.Name]
			local hasPos = entry.dropPos and "✓" or "?"

			local visibleEntries = {}
			local seenKeys       = {}
			for _, it in ipairs(entry.shop:GetChildren()) do
				if it:IsA("Model") then
					local cd       = getCDValue(it)
					local display  = cd and (cd .. "  (" .. it.Name .. ")") or it.Name
					local key      = cd or ("__name:" .. it.Name)
					if not seenKeys[key] and passesFilter(entry.storeName, display) then
						seenKeys[key] = true
						table.insert(visibleEntries, {
							name    = it.Name,
							cd      = cd,
							display = display,
						})
					end
				end
			end

			local storeMatches = passesFilter(entry.storeName, nil)
			if not storeMatches and #visibleEntries == 0 then
				continue
			end

			order = order + 1
			local storeOrder = order * 1000

			local header = Instance.new("TextLabel", storeEntriesFrame)
			header.Size = UDim2.new(1, 0, 0, 24)
			header.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
			header.Text = ("  %s  (%s)  ID=%s  %s"):format(
				entry.storeName, entry.npc.Name,
				id and tostring(id) or "?", hasPos)
			header.TextXAlignment = Enum.TextXAlignment.Left
			header.TextColor3 = Color3.fromRGB(220, 220, 220)
			header.Font = Enum.Font.SourceSansBold
			header.TextSize = 12
			header.LayoutOrder = storeOrder
			Instance.new("UICorner", header).CornerRadius = UDim.new(0, 4)

			local buyAll = Instance.new("TextButton", storeEntriesFrame)
			buyAll.Size = UDim2.new(1, 0, 0, 26)
			buyAll.BackgroundColor3 = Color3.fromRGB(80, 160, 90)
			buyAll.Text = "  Buy ALL  —  " .. entry.storeName
			buyAll.TextXAlignment = Enum.TextXAlignment.Left
			buyAll.TextColor3 = Color3.fromRGB(255, 255, 255)
			buyAll.Font = Enum.Font.SourceSansBold
			buyAll.TextSize = 12
			buyAll.LayoutOrder = storeOrder + 1
			Instance.new("UICorner", buyAll).CornerRadius = UDim.new(0, 4)

			buyAll.MouseButton1Click:Connect(function()
				if buyingStores[entry.storeName] then return end
				buyingStores[entry.storeName] = true
				buyAll.Text = "  Working..."

				task.spawn(function()
					local char = player.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					local startCF = root and root.CFrame

					local snapshot = {}
					for _, it in ipairs(entry.shop:GetChildren()) do
						if it:IsA("Model") then
							table.insert(snapshot, it)
						end
					end

					for _, it in ipairs(snapshot) do
						if it and it.Parent then
							pcall(buyItem, entry, it, true)
							task.wait(0.4)
						end
					end

					returnHome(root, startCF)

					buyingStores[entry.storeName] = false
					buyAll.Text = "  Buy ALL  —  " .. entry.storeName
					notify("AutoBuy", "Done: " .. entry.storeName, 3)
				end)
			end)

			for j, ve in ipairs(visibleEntries) do
				local btn = Instance.new("TextButton", storeEntriesFrame)
				btn.Size = UDim2.new(1, -14, 0, 22)
				btn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
				btn.Text = "    " .. ve.display
				btn.TextXAlignment = Enum.TextXAlignment.Left
				btn.TextColor3 = Color3.fromRGB(230, 230, 230)
				btn.Font = Enum.Font.SourceSans
				btn.TextSize = 11
				btn.LayoutOrder = storeOrder + 100 + j
				Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)

				local targetKey = ve.cd or ve.name
				btn.MouseButton1Click:Connect(function()
					task.spawn(function()
						buyItemMultiple(entry, targetKey, buyQuantity)
					end)
				end)
			end
		end

		if order == 0 then
			local empty = Instance.new("TextLabel", storeEntriesFrame)
			empty.Size = UDim2.new(1, 0, 0, 0)
			empty.AutomaticSize = Enum.AutomaticSize.Y
			empty.BackgroundTransparency = 1
			empty.Text = "No items match: " .. searchBox.Text
			empty.TextColor3 = Color3.fromRGB(180, 180, 180)
			empty.Font = Enum.Font.SourceSans
			empty.TextSize = 12
			empty.TextWrapped = true
			empty.TextXAlignment = Enum.TextXAlignment.Left
			empty.TextYAlignment = Enum.TextYAlignment.Top
		end
	end

